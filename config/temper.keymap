        o_circ_lower_linux: o_circ_lower_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp O &to 1>;
            label = "O_CIRC_LOWER_LINUX";
        };

        o_circ_upper_linux: o_circ_upper_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(O) &to 1>;
            label = "O_CIRC_UPPER_LINUX";
        };

        a_grave_lower_linux: a_grave_lower_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &to 1>;
            label = "A_GRAVE_LOWER_LINUX";
