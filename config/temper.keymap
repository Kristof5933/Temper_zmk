        oe_ligature_linux_upper: oe_ligature_linux_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(GRAVE) &to 1>;
            label = "OE_LIGATURE_LINUX_UPPER";
