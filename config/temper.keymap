        };

        u_circ_windows: u_circ_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CIRC_WINDOWS";
            bindings = <&u_circ_lower_windows>, <&u_circ_upper_windows>;

            #binding-cells = <0>;
