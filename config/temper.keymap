#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800  // 600, 1200
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener {
    precisionnav {
        layers = <1>;
        input-processors = <&zip_xy_scaler 1 3>;
    };

    precisionnum {
        layers = <2>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

&lt { tapping-term-ms = <165>; };

/ {
    behaviors {
        mmv {
            acceleration-exponent = <2>; // 1
            time-to-max-speed-ms = <40>; // 40
            delay-ms = <0>; // 0
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <65>;
            tapping-term-ms = <125>;
            global-quick-tap;
            flavor = "tap-preferred";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 20 21 22 23 24 14 25 15 5 6 16 26 27 17 7 8 18 28 29 19 9 11 12 13>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 10 20 21 1 11 12 2 3 4 24 14 13 23 22 25 26 28 27 29 9 8 7 6 5 15 16 17 18 30 31 32 33 34 35>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        space_alt: space_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_ALT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <10 12 20 21 16 17 19 6>;
            hold-trigger-on-release;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            bindings = <&kp LS(COMMA)>, <&kp DOT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semicolon: comma_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMICOLON";
            bindings = <&kp M>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        o_circ_upper_lower_windows: o_circ_upper_lower_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "O_CIRC_UPPER_LOWER_WINDOWS";
            bindings = <&o_circ_windows>, <&o_circ_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dash_question: dash_question {
            compatible = "zmk,behavior-mod-morph";
            label = "DASH_QUESTION";
            bindings = <&kp NUMBER_6>, <&kp LS(M)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        a_circ_linux: a_circ_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "A_CIRC_LINUX";
            bindings = <&a_circ_linux_lower>, <&a_circ_linux_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        a_circ_windows: a_circ_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "A_CIRC_WINDOWS";
            bindings = <&a_circ_windows_lower>, <&a_circ_windows_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        c_cedilla_windows: c_cedilla_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "C_CEDILLA_WINDOWS";
            bindings = <&kp N9>, <&c_cedilla_windows_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        a_acute: a_acute {
            compatible = "zmk,behavior-mod-morph";
            label = "A_ACUTE";
            bindings = <&kp N0>, <&a_acute_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_acute_windows: e_acute_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "E_ACUTE_WINDOWS";
            bindings = <&kp NUMBER_2>, <&e_acute_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_acute_linux: e_acute_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "E_ACUTE_LINUX";
            bindings = <&kp NUMBER_2>, <&e_acute_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_grave: e_grave {
            compatible = "zmk,behavior-mod-morph";
            label = "E_GRAVE";
            bindings = <&kp N7>, <&e_grave_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_grave: u_grave {
            compatible = "zmk,behavior-mod-morph";
            label = "U_GRAVE";
            bindings = <&kp SINGLE_QUOTE>, <&u_grave_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        accent_layer_linux: accent_layer_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "ACCENT_LAYER_LINUX";
            bindings = <&to 2>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        accent_layer_windows: accent_layer_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "ACCENT_LAYER_WINDOWS";
            bindings = <&sl 3>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        oe_ligature_upper_lower_linux: oe_ligature_upper_lower_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "OE_LIGATURE_UPPER_LOWER_LINUX";
            bindings = <&oe_ligature_linux_lower>, <&oe_ligature_linux_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        o_circ_upper_lower_linux: o_circ_upper_lower_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "O_CIRC_UPPER_LOWER_LINUX";
            bindings = <&o_circ_linux>, <&o_circ_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <10 19>;
            layers = <0>;
        };

        Alt+tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <10 11 12>;
            layers = <0>;
            timeout-ms = <100>;
        };

        Tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 10>;
            layers = <0>;
        };

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <21 22>;
            layers = <0>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <22 23>;
            layers = <0>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
            layers = <0>;
        };

        screenshot {
            bindings = <&kp LG(LS(S))>;
            key-positions = <9 8>;
            layers = <0>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <27 28>;
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <18 19>;
            layers = <0>;
            timeout-ms = <150>;
        };

        boot_l {
            bindings = <&bootloader>;
            key-positions = <0 4 32>;
            layers = <0>;
        };

        alt_f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <0 1 2>;
            layers = <0>;
        };

        esc_left {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
            timeout-ms = <100>;
        };

        bluetooth {
            bindings = <&mo 8>;
            key-positions = <32 33>;
        };

        win_nav_left {
            bindings = <&kp LG(LEFT)>;
            key-positions = <16 17>;
            layers = <10>;
        };

        win_nav_right {
            bindings = <&kp LG(RIGHT)>;
            key-positions = <19 18>;
            layers = <10>;
        };

        win_nav_up {
            bindings = <&kp LG(UP_ARROW)>;
            key-positions = <7 8>;
            layers = <10>;
        };

        win_nav_down {
            bindings = <&kp LG(DOWN_ARROW)>;
            key-positions = <17 18>;
            layers = <10>;
        };

        win_nav_left_shift {
            bindings = <&kp LG(LS(LEFT))>;
            key-positions = <16 17 18>;
            layers = <10>;
        };

        win_nav_right_shift {
            bindings = <&kp LG(LS(RIGHT))>;
            key-positions = <19 18 17>;
            layers = <10>;
        };

        num_equal {
            bindings = <&kp EQUAL>;
            key-positions = <16 17 18>;
            layers = <7>;
            timeout-ms = <175>;
        };

        num_par_left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            layers = <7>;
        };

        num_par_right {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 19>;
            layers = <7>;
        };

        del_left {
            bindings = <&kp DEL>;
            key-positions = <20 23>;
            timeout-ms = <200>;
        };

        mouse_layer_switch {
            bindings = <&tog 11>;
            key-positions = <14 15>;
            timeout-ms = <175>;
        };

        switch_to_win {
            bindings = <&to 1>;
            key-positions = <33 34>;
            layers = <0>;
        };

        switch_to_linux {
            bindings = <&to 0>;
            key-positions = <33 34>;
            layers = <1>;
        };
    };

    macros {
        a_circ_linux_lower: a_circ_linux_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bidings = <&kp RA(Q)> &to 0>;
            label = "A_CIRC_LINUX_LOWER";
        } 

        a_circ_linux_upper: a_circ_linux_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bidings = <&kp RA(A)> &to 0>;
            label = "A_CIRC_LINUX_UPPER";
        } 

        a_circ_windows_lower: a_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp Q>;
            label = "A_CIRC";
        };

        oe_ligature_linux_lower: oe_ligature_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N1 &kp N5 &kp N3 &kp ENTER &to 0>;
            label = "OE_LIGATURE_LINUX";
        };

        o_circ_windows: o_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp O>;
            label = "O_CIRC";
        };

        e_circ: e_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp E>;
            label = "E_CIRC";
        };

        ae_ligature_linux_lower: ae_ligature {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N0 &kp E &kp N6 &kp RET &to 0>;
            label = "AE_LIGATURE";
        };

        i_circ: i_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp I>;
            label = "I_CIRC";
        };

        i_diaresis: i_diaresis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp I>;
            label = "I_DIARESIS";
        };

        u_circ: u_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp U>;
            label = "U_CIRC";
        };

        o_circ_upper_windows: o_circ_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(O)>;
            label = "O_CIRC_MAJ";
        };

        circ: circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp SPACE>;
            label = "CIRC";
        };

        back_tick: back_tick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N7) &kp SPACE>;
            label = "BACK_TICK";
        };

        oe_ligature_windows: oe_ligature_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_N1 &kp KP_N5 &kp KP_N6 &kt LEFT_ALT>;
            label = "OE_LIGATURE_WINDOWS";
        };

        tilde_windows: tilde_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(NUMBER_2) &kp SPACE>;
            label = "TILDE_WINDOWS";
        };

        ae_ligature_windows: ae_windows_ligature {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N0 &kt LEFT_ALT>;
            label = "AE_WINDOWS_LIGATURE";
        };

        a_circ_windows_upper: a_circ_windows_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(Q)>;
            label = "A_CIRC_WINDOWS_MAJ";
        };

        c_cedilla_windows_upper: c_cedilla_maj_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N9 &kt LEFT_ALT>;
            label = "C_CEDILLA_MAJ_WINDOWS";
        };

        a_acute_upper: a_acute_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N7) &kp A>;
            label = "A_ACUTE_UPPER";
        };

        e_acute_upper_linux: e_acute_upper_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(U)) &kp KP_N0 &kp KP_N0 &kp C &kp KP_N9 &kp ENTER &to 0>;
            label = "E_ACUTE_UPPER_LINUX";
        };

        e_acute_upper_windows: a_acute_upper_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N1 &kt LEFT_ALT &to 0>;
            label = "A_ACUTE_UPPER_WINDOWS";
        };

        e_grave_upper: e_grave_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N7) &kp LS(E)>;
            label = "E_GRAVE_UPPER";
        };

        u_grave_upper: u_grave_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N7) &kp LS(U)>;
            label = "U_GRAVE_UPPER";
        };

        typographical_apo_linux: typographical_apo_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(U)) &kp KP_N2 &kp KP_N0 &kp KP_N1 &kp KP_N9 &kp ENTER &to 0>;
            label = "TYPOGRAPHICAL_APO_LINUX";
        };

        typographical_apo_windows: typographical_apo_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_N0 &kp KP_N1 &kp KP_N4 &kp KP_N6 &kt LEFT_ALT>;
            label = "TYPOGRAPHICAL_APO_WINDOWS";
        };

        oe_ligature_linux_upper: oe_ligature_linux_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(U)) &kp N0 &kp N1 &kp N5 &kp KP_N2 &kp ENTER &to 0>;
            label = "OE_LIGATURE_LINUX_UPPER";
        };

        o_circ_linux: o_circ_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp O &to 0>;
            label = "O_CIRC_LINUX";
        };

        o_circ_upper_linux: o_circ_upper_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(O)>;
            label = "O_CIRC_UPPER_LINUX";
        };

        a_circ_linux_lower: a_circ_linux_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(Q) &to 0>;
            label = "A_CIRC_LINUX_LOWER";
        };

        a_circ_linux_upper: a_circ_linux_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(A) &to 0>;
            label = "A_CIRC_LINUX_UPPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Basel {
            //            display-name = "Base";

            bindings = <
  &kp A            &kp C           &kp O               &kp P            &kp Z                 &kp J        &kp SEMICOLON  &kp D                &accent_layer_linux  &kp Y
  &hml LEFT_GUI Q  &hm LEFT_ALT S  &hm LEFT_CONTROL E  &kp N            &kp F                 &kp L        &kp R          &hm RIGHT_CONTROL T  &hm RIGHT_ALT I      &hmr RIGHT_GUI U
  &kp W            &kp X           &dash_question      &kp V            &kp B                 &dot_colon   &kp H          &kp G                &comma_semicolon     &kp K
                                   &lt 8 ESCAPE        &lt 7 BACKSPACE  &hm LEFT_SHIFT TAB    &lt 9 ENTER  &lt 4 SPACE    &lt 5 DEL
            >;

            label = "linux";
        };

        Basew {
            label = "windows";

            //            display-name = "Base";

            bindings = <
  &kp A            &kp C           &kp O               &kp P            &kp Z                 &kp J        &kp SEMICOLON  &kp D                &accent_layer_windows  &kp Y
  &hml LEFT_GUI Q  &hm LEFT_ALT S  &hm LEFT_CONTROL E  &kp N            &kp F                 &kp L        &kp R          &hm RIGHT_CONTROL T  &hm RIGHT_ALT I        &hmr RIGHT_GUI U
  &kp W            &kp X           &dash_question      &kp V            &kp B                 &dot_colon   &kp H          &kp G                &comma_semicolon       &kp K
                                   &lt 8 ESCAPE        &lt 7 BACKSPACE  &hm LEFT_SHIFT TAB    &lt 9 ENTER  &lt 4 SPACE    &lt 6 DEL
            >;
        };

        AccentsL {
            bindings = <
  &a_circ_linux             &kp RA(R)       &oe_ligature_upper_lower_linux  &o_circ_upper_lower_linux  &none             &none   &none                     &kp N8   &none        &u_circ
  &a_acute                  &e_acute_linux  &e_grave                        &e_circ                    &none             &kp N5  &kp MINUS                 &i_circ  &i_diaresis  &u_grave
  &ae_ligature_linux_lower  &none           &none                           &none                      &none             &none   &none                     &none    &none        &none
                                            &none                           &none                      &kp LEFT_SHIFT    &none   &typographical_apo_linux  &none
            >;

            label = "Accts lnx";
        };

        AccentsW {
            label = "Accts win";
            bindings = <
  &a_circ_windows       &c_cedilla_windows  &oe_ligature_windows  &o_circ_upper_lower_windows  &none             &none   &none                       &kp N8   &none        &u_circ
  &a_acute              &e_acute_windows    &e_grave              &e_circ                      &none             &kp N5  &kp MINUS                   &i_circ  &i_diaresis  &u_grave
  &ae_ligature_windows  &none               &none                 &none                        &none             &none   &none                       &none    &none        &none
                                            &none                 &none                        &sk LEFT_SHIFT    &none   &typographical_apo_windows  &none
            >;
        };

        Nav {
            bindings = <
  &bootloader   &none         &kp LC(PRINTSCREEN)  &none           &studio_unlock    &kp INS         &kp HOME  &kp UP_ARROW  &kp PAGE_UP    &bootloader
  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL            &kp LEFT_SHIFT  &none             &msc SCRL_UP    &kp LEFT  &kp DOWN      &kp RIGHT      &none
  &kp LC(Z)     &kp LC(Y)     &kp LC(X)            &kp LC(C)       &kp LC(V)         &msc SCRL_DOWN  &kp END   &none         &kp PAGE_DOWN  &kp CAPSLOCK
                              &none                &none           &trans            &none           &none     &none
            >;

            label = "Nav";
        };

        AltGrL {
            bindings = <
  &circ             &kp NON_US_BACKSLASH  &kp LS(NON_US_BACKSLASH)  &kp RIGHT_BRACKET  &kp LS(APOS)        &kp RA(N0)        &kp NUMBER_1  &kp KP_MULTIPLY  &kp NUMBER_4    &back_tick
  &kp RA(NUMBER_4)  &kp N5                &kp MINUS                 &kp RA(EQUAL)      &kp EQUAL           &kp RA(N8)        &kp KP_PLUS   &kp NUMBER_6     &kp LS(PERIOD)  &kp NUMBER_3
  &kp RA(NUMBER_2)  &kp RA(N5)            &kp RA(MINUS)             &kp N8             &kp RA(NUMBER_3)    &kp RA(NUMBER_6)  &kp SLASH     &kp COMMA        &kp DOT         &kp LS(M)
                                          &none                     &none              &none               &none             &none         &none
            >;

            label = "AltGr l";
        };

        AltGrW {
            label = "AltGr w";
            bindings = <
  &circ             &kp NON_US_BACKSLASH  &kp LS(NON_US_BACKSLASH)  &kp RIGHT_BRACKET  &kp LS(APOS)        &kp RA(N0)        &kp NUMBER_1  &kp KP_MULTIPLY  &kp NUMBER_4  &back_tick
  &kp RA(NUMBER_4)  &kp N5                &kp MINUS                 &kp RA(EQUAL)      &kp EQUAL           &kp RA(N8)        &kp KP_PLUS   &kp NUMBER_6     &kp LS(DOT)   &kp NUMBER_3
  &tilde_windows    &kp RA(N5)            &kp RA(MINUS)             &kp N8             &kp RA(NUMBER_3)    &kp RA(NUMBER_6)  &kp SLASH     &kp COMMA        &kp DOT       &kp LS(M)
                                          &none                     &none              &none               &none             &none         &none
            >;
        };

        Num {
            bindings = <
  &bootloader  &none  &none  &none  &studio_unlock    &kp KP_MULTIPLY      &kp LS(N7)        &kp LS(N8)        &kp LS(N9)        &bootloader
  &none        &none  &none  &none  &none             &kp KP_DIVIDE        &kp LS(NUMBER_4)  &kp LS(N5)        &kp LS(NUMBER_6)  &kp LS(COMMA)
  &none        &none  &none  &none  &none             &kp LS(KP_SUBTRACT)  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp COMMA
                      &none  &none  &none             &kp KP_PLUS          &kp LS(N0)        &kp EQUAL
            >;

            label = "Num";
        };

        Media {
            display-name = "Media";
            bindings = <
  &bootloader  &none  &none  &none  &none    &none             &none         &none            &none         &bootloader
  &none        &none  &none  &none  &none    &kp C_PREVIOUS    &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_NEXT    &none
  &none        &none  &none  &none  &none    &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4
                      &none  &none  &none    &kp C_PLAY_PAUSE  &kp C_PAUSE   &kp C_MUTE
            >;
        };

        Funct {
            bindings = <
  &kp F12  &kp F7  &kp F8  &kp F9  &trans    &trans  &trans  &trans  &trans  &trans
  &kp F11  &kp F4  &kp F5  &kp F6  &trans    &trans  &trans  &trans  &trans  &trans
  &kp F10  &kp F1  &kp F2  &kp F3  &trans    &trans  &trans  &trans  &trans  &trans
                   &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Funct";
        };

        focus_switch {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(N4)  &kp LG(N5)  &kp LG(N6)  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &trans
                  &trans  &trans  &trans    &trans  &trans      &trans
            >;

            label = "Focus";
        };

        mouse {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans          &trans
  &trans  &trans  &trans  &trans  &trans    &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
  &trans  &trans  &trans  &trans  &trans    &msc SCRL_DOWN  &trans          &trans        &trans          &trans
                  &trans  &trans  &trans    &mkp LCLK       &mkp MCLK       &mkp RCLK
            >;

            label = "Mouse";
        };
    };
};
