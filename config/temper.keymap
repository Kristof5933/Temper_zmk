        c_cedilla_linux_upper: c_cedilla_linux_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(LS(R)) &to 1>;
            label = "C_CEDILLA_LINUX_UPPER";
        };

        oe_ligature_linux_lower: oe_ligature_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &to 1>;
            label = "OE_LIGATURE_LINUX_LOWER";
