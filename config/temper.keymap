        right_parenthesis_no_case: right_parenthesis_no_case {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_PARENTHESIS_NO_CASE";
            bindings = <&right_parenthesis_linux>, <&right_parenthesis_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        i_circ_linux: i_circ_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "I_CIRC_LINUX";
            bindings = <&i_circ_lower_linux>, <&i_circ_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        i_diaresis_linux: i_diaresis_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "I_DIARESIS_LINUX";
            bindings = <&i_diaresis_lower_linux>, <&i_diaresis_upper_linux>;

