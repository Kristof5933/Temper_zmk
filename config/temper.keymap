        };

        i_diaresis_windows: i_diaresis_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "I_DIARESIS_WINDOWS";
            bindings = <&i_diaresis_lower_windows>, <&i_diaresis_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        i_circ_windows: i_circ_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "I_CIRC_WINDOWS";
            bindings = <&i_circ_lower_windows>, <&i_circ_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        left_parenthesis_windows_nocase: left_parenthesis_windows_nocase {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_PARENTHESIS_WINDOWS_NOCASE";
            bindings = <&left_parenthesis_windows>, <&left_parenthesis_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        right_parenthesis_windows_nocas: right_parenthesis_windows_nocas {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_PARENTHESIS_WINDOWS_NOCAS";
            bindings =
                <&right_parenthesis_windows>,
                <&right_parenthesis_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        oe_ligature_windows: oe_ligature_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "OE_LIGATURE_WINDOWS";
            bindings =
                <&oe_ligature_windows_lower>,
                <&oe_ligature_upper_windows>;

            #binding-cells = <0>;
