        };

        underscore_windows: underscore_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N8 &to 2>;
            label = "UNDERSCORE_WINDOWS";
        };

        u_circ_upper_windows: u_circ_upper_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(U) &to 2>;
            label = "U_CIRC_UPPER_WINDOWS";
        };

        u_grave_lower_windows: u_grave_lower_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N7) &kp U &to 2>;
            label = "U_GRAVE_LOWER_WINDOWS";
        };

        i_diaresis_upper_windows: i_diaresis_upper_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp LS(I) &to 2>;
            label = "I_DIARESIS_UPPER_WINDOWS";
        };

        i_circ_upper_windows: i_circ_upper_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(I) &to 2>;
            label = "I_CIRC_UPPER_WINDOWS";
        };

        left_parenthesis_windows: left_parenthesis_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N5 &to 2>;
            label = "LEFT_PARENTHESIS_WINDOWS";
        };

        right_parenthesis_windows: right_parenthesis_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &to 2>;
            label = "RIGHT_PARENTHESIS_WINDOWS";
        };

        oe_ligature_upper_windows: oe_ligature_upper_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_N1 &kp KP_N4 &kp KP_N0 &kt LEFT_ALT &to 2>;
            label = "OE_LIGATURE_UPPER_WINDOWS";
        };

        c_cedila_lower_windows: c_cedila_lower_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N9 &to 2>;
            label = "C_CEDILA_LOWER_WINDOWS";
        };

        a_grave_upper_windows: a_grave_upper_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N7) &kp LS(Q) &to 2>;
            label = "A_GRAVE_UPPER_WINDOWS";
        };

        e_acute_lower_windows: e_acute_lower_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &to 2>;
            label = "E_ACUTE_LOWER_WINDOWS";
        };

        e_grave_lower_windows: e_grave_lower_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &to 2>;
            label = "E_GRAVE_LOWER_WINDOWS";
        };

        e_circ_upper_windows: e_circ_upper_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(E) &to 2>;
            label = "E_CIRC_UPPER_WINDOWS";
        };

        ae_ligature_upper_windows: ae_ligature_upper_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N8 &kt LEFT_ALT &to 2>;
            label = "AE_LIGATURE_UPPER_WINDOWS";
        };

        shift_right_click: shift_right_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_SHIFT &mkp RCLK &kt LEFT_SHIFT>;
            label = "SHIFT_RIGHT_CLICK";
        };

        tmux_new_pane: tmux_new_pane {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp C>;
            label = "TMUX_NEW_PANE";
        };

        tmux_vsplit: tmux_vsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp AT>;
            label = "TMUX_VSPLIT";
        };

        tmux_hsplit: tmux_hsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp NUMBER_3>;
            label = "TMUX_HSPLIT";
        };

        tmux_pane_left: tmux_pane_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp LEFT>;
            label = "TMUX_PANE_LEFT";
        };

        tmux_pane_right: tmux_pane_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp RIGHT>;
            label = "TMUX_PANE_RIGHT";
        };

        tmux_pane_up: tmux_pane_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp UP_ARROW>;
            label = "TMUX_PANE_UP";
        };

        tmux_pane_down: tmux_pane_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp DOWN>;
            label = "TMUX_PANE_DOWN";
        };

        tmux_pane_zoom: tmux_pane_zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp Z>;
            label = "TMUX_PANE_ZOOM";
        };

        tmux_pane_close: tmux_pane_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp X>;
            label = "TMUX_PANE_CLOSE";
        };

        tmux_next_window: tmux_next_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N>;
            label = "TMUX_NEXT_WINDOW";
        };

        tmux_prev_window: tmux_prev_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp P>;
            label = "TMUX_PREV_WINDOW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        ergol {
            label = "ergol";
            bindings = <
  &kp Q            &kp W           &kp E               &kp R        &kp T                 &kp Y                &kp U        &kp I                &kp O            &kp P
  &hml LEFT_GUI A  &hm LEFT_ALT S  &hm LEFT_CONTROL D  &kp F        &kp G                 &kp H                &kp J        &hm RIGHT_CONTROL K  &hm RIGHT_ALT L  &hmr RIGHT_GUI SEMICOLON
  &kp Z            &kp X           &kp C               &kp V        &kp B                 &kp N                &kp M        &kp COMMA            &kp PERIOD       &kp SLASH
                                   &lt 9 ESCAPE        &lt 8 SPACE  &hm LEFT_SHIFT TAB    &mt RIGHT_ALT ENTER  &lt 5 SPACE  &lt 6 DEL
            >;
        };

        Basel {
            //            display-name = "Base";

            bindings = <
  &kp A            &kp C           &kp O               &kp P        &kp Z                 &kp J        &kp SEMICOLON  &kp D                &accent_layer_linux  &kp Y
  &hml LEFT_GUI Q  &hm LEFT_ALT S  &hm LEFT_CONTROL E  &kp N        &kp F                 &kp L        &kp R          &hm RIGHT_CONTROL T  &hm RIGHT_ALT I      &hmr RIGHT_GUI U
  &kp W            &kp X           &dash_question      &kp V        &kp B                 &dot_colon   &kp H          &kp G                &comma_semicolon     &kp K
                                   &lt 9 ESCAPE        &lt 8 SPACE  &hm LEFT_SHIFT TAB    &lt 6 ENTER  &lt 5 SPACE    &lt 10 DEL
            >;

            label = "linux";
        };

        Basew {
            label = "windows";

            //            display-name = "Base";

            bindings = <
  &kp A            &kp C           &kp O               &kp P        &kp Z                 &kp J        &kp SEMICOLON  &kp D                &accent_layer_windows  &kp Y
  &hml LEFT_GUI Q  &hm LEFT_ALT S  &hm LEFT_CONTROL E  &kp N        &kp F                 &kp L        &kp R          &hm RIGHT_CONTROL T  &hm RIGHT_ALT I        &hmr RIGHT_GUI U
  &kp W            &kp X           &dash_question      &kp V        &kp B                 &dot_colon   &kp H          &kp G                &comma_semicolon       &kp K
                                   &lt 9 ESCAPE        &lt 8 SPACE  &hm LEFT_SHIFT TAB    &lt 7 ENTER  &lt 5 SPACE    &lt 10 DEL
            >;
        };

        AccentsL {
            bindings = <
  &a_circ_linux       &c_cedilla_linux  &oe_ligature_linux  &o_circ_linux  &to 1             &to 1                           &to 1                       &underscore_linux  &to 1              &u_circ_linux
  &a_grave_linux      &e_acute_linux    &e_grave_linux      &e_circ_linux  &to 1             &left_parenthesis_linux_nocase  &right_parenthesis_no_case  &i_circ_linux      &i_diaresis_linux  &u_grave_linux
  &ae_ligature_linux  &to 1             &to 1               &to 1          &to 1             &to 1                           &to 1                       &to 1              &to 1              &to 1
                                        &to 1               &to 1          &kp LEFT_SHIFT    &to 1                           &typographical_apo_linux    &to 1
            >;

            label = "Accts lnx";
        };

        AccentsW {
            label = "Accts win";
            bindings = <
  &a_circ_windows       &c_cedilla_windows  &oe_ligature_windows  &o_circ_windows  &to 2             &to 2                             &to 2                             &underscore_windows  &to 2                &u_circ_windows
  &a_grave_windows      &e_acute_windows    &e_grave_windows      &e_circ_windows  &to 2             &left_parenthesis_windows_nocase  &right_parenthesis_windows_nocas  &i_circ_windows      &i_diaresis_windows  &u_grave_windows
  &ae_ligature_windows  &to 2               &to 2                 &to 2            &to 2             &to 2                             &to 2                             &to 2                &to 2                &to 2
                                            &to 2                 &to 2            &kp LEFT_SHIFT    &to 2                             &typographical_apo_windows        &to 2
            >;
        };

        Nav {
            bindings = <
  &bootloader   &none         &kp LC(PRINTSCREEN)  &none           &studio_unlock    &kp INS         &kp HOME  &kp UP_ARROW  &kp PAGE_UP    &bootloader
  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL            &kp LEFT_SHIFT  &none             &msc SCRL_UP    &kp LEFT  &kp DOWN      &kp RIGHT      &none
  &kp LC(Z)     &kp LC(Y)     &kp LC(X)            &kp LC(C)       &kp LC(V)         &msc SCRL_DOWN  &kp END   &kp DOWN      &kp PAGE_DOWN  &kp CAPSLOCK
                              &none                &none           &trans            &none           &none     &none
            >;

            label = "Nav";
        };

        AltGrL {
            bindings = <
  &circ             &kp NON_US_BACKSLASH  &kp LS(NON_US_BACKSLASH)  &kp RIGHT_BRACKET  &kp LS(APOS)        &kp RA(N0)        &kp NUMBER_1  &kp KP_MULTIPLY  &kp NUMBER_4    &back_tick
  &kp RA(NUMBER_4)  &kp N5                &kp MINUS                 &kp RA(EQUAL)      &kp EQUAL           &kp RA(N8)        &kp KP_PLUS   &kp NUMBER_6     &kp LS(PERIOD)  &kp NUMBER_3
  &kp RA(NUMBER_2)  &kp RA(N5)            &kp RA(MINUS)             &kp N8             &kp RA(NUMBER_3)    &kp RA(NUMBER_6)  &kp SLASH     &kp COMMA        &kp DOT         &kp LS(M)
                                          &none                     &none              &none               &none             &none         &none
            >;

            label = "AltGr l";
        };

        AltGrW {
            label = "AltGr w";
            bindings = <
  &circ             &kp NON_US_BACKSLASH  &kp LS(NON_US_BACKSLASH)  &kp RIGHT_BRACKET  &kp LS(APOS)        &kp RA(N0)        &kp NUMBER_1  &kp KP_MULTIPLY  &kp NUMBER_4  &back_tick
  &kp RA(NUMBER_4)  &kp N5                &kp MINUS                 &kp RA(EQUAL)      &kp EQUAL           &kp RA(N8)        &kp KP_PLUS   &kp NUMBER_6     &kp LS(DOT)   &kp NUMBER_3
  &tilde_windows    &kp RA(N5)            &kp RA(MINUS)             &kp N8             &kp RA(NUMBER_3)    &kp RA(NUMBER_6)  &kp SLASH     &kp COMMA        &kp DOT       &kp LS(M)
                                          &none                     &none              &none               &none             &none         &none
            >;
        };

        Num {
            bindings = <
  &bootloader  &none  &none  &none  &studio_unlock    &kp KP_MULTIPLY      &kp LS(N7)        &kp LS(N8)        &kp LS(N9)        &kp RA(E)
  &none        &none  &none  &none  &none             &kp KP_DIVIDE        &kp LS(NUMBER_4)  &kp LS(N5)        &kp LS(NUMBER_6)  &kp LS(COMMA)
  &none        &none  &none  &none  &none             &kp LS(KP_SUBTRACT)  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(COMMA)
                      &none  &none  &none             &kp KP_PLUS          &kp LS(N0)        &kp EQUAL
            >;

            label = "Num";
        };

        Media {
            display-name = "Media";
            bindings = <
  &bootloader  &none  &none  &none  &none    &none             &none         &none            &none         &bootloader
  &none        &none  &none  &none  &none    &kp C_PREVIOUS    &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_NEXT    &none
  &none        &none  &none  &none  &none    &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4
                      &none  &none  &none    &kp C_PLAY_PAUSE  &kp C_PAUSE   &kp C_MUTE
            >;
        };

        Funct {
            bindings = <
  &kp F12  &kp F7  &kp F8  &kp F9  &trans    &trans  &trans  &trans  &trans  &trans
  &kp F11  &kp F4  &kp F5  &kp F6  &trans    &trans  &trans  &trans  &trans  &trans
  &kp F10  &kp F1  &kp F2  &kp F3  &trans    &trans  &trans  &trans  &trans  &trans
                   &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Funct";
        };

        focus_switch {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(N4)  &kp LG(N5)  &kp LG(N6)  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &trans
                  &trans  &trans  &trans    &trans  &trans      &trans
            >;

            label = "Focus";
        };

        mouse {
            bindings = <
  &none  &none  &none  &none  &none    &msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none
  &none  &none  &none  &none  &none    &none           &mmv MOVE_LEFT  &none           &mmv MOVE_RIGHT  &none
  &none  &none  &none  &none  &none    &msc SCRL_DOWN  &none           &mmv MOVE_DOWN  &none            &none
                &none  &none  &none    &none           &none           &none
            >;

            label = "Mouse";
        };

        Tmux {
            bindings = <
  &trans  &trans  &trans  &trans  &trans              &tmux_new_pane  &tmux_prev_window  &tmux_pane_up    &tmux_next_window  &trans
  &trans  &trans  &trans  &trans  &trans              &tmux_hsplit    &tmux_pane_left    &tmux_pane_zoom  &tmux_pane_right   &trans
  &trans  &trans  &trans  &trans  &trans              &tmux_vsplit    &trans             &tmux_pane_down  &trans             &tmux_pane_close
                  &trans  &trans  &kp LEFT_CONTROL    &trans          &trans             &trans
            >;

            label = "Tmux";
        };
    };
};
