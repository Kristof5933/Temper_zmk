        };

        i_circ_lower_windows: i_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp I &to 2>;
            label = "I_CIRC";
        };

        i_diaresis_lower_windows: i_diaresis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp I &to 2>;
            label = "I_DIARESIS";
        };

        u_circ_lower_windows: u_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp U &to 2>;
            label = "U_CIRC";
        };

        o_circ_upper_windows: o_circ_maj {
