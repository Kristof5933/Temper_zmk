#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800  // 600, 1200
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener {
    precisionnav {
        layers = <1>;
        input-processors = <&zip_xy_scaler 1 3>;
    };

    precisionnum {
        layers = <2>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

&lt { tapping-term-ms = <165>; };

/ {
    behaviors {
        mmv {
            acceleration-exponent = <2>; // 1
            time-to-max-speed-ms = <40>; // 40
            delay-ms = <0>; // 0
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            global-quick-tap;
            flavor = "balanced";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 20 21 22 23 24 14 25 15 5 6 16 26 27 17 7 8 18 28 29 19 9 11 12 13>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 10 20 21 1 11 12 2 3 4 24 14 13 23 22 25 26 28 27 29 9 8 7 6 5 15 16 17 18 30 31 32 33 34 35>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        space_alt: space_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_ALT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <10 12 20 21 16 17 19 6>;
            hold-trigger-on-release;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            bindings = <&kp LS(COMMA)>, <&kp DOT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semicolon: comma_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMICOLON";
            bindings = <&kp M>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        a_circ_linux: a_circ_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "A_CIRC_LINUX";
            bindings = <&a_circ_linux_lower>, <&a_circ_linux_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        c_cedilla_linux: c_cedilla_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "C_CEDILLA_LINUX";
            bindings = <&c_cedilla_linux_lower>, <&c_cedilla_linux_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        oe_ligature_linux: oe_ligature_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "OE_LIGATURE_LINUX";
            bindings = <&oe_ligature_linux_lower>, <&oe_ligature_linux_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        o_circ_linux: o_circ_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "O_CIRC_LINUX";
            bindings = <&o_circ_lower_linux>, <&o_circ_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        a_grave_linux: a_grave_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "A_GRAVE_LINUX";
            bindings = <&a_grave_lower_linux>, <&a_grave_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_acute_linux: e_acute_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "E_ACUTE_LINUX";
            bindings = <&e_acute_lower_linux>, <&e_acute_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_grave_linux: e_grave_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "E_GRAVE_LINUX";
            bindings = <&e_grave_lower_linux>, <&e_grave_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_circ_linux: e_circ_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "E_CIRC_LINUX";
            bindings = <&e_circ_lower_linux>, <&e_circ_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        o_circ_windows: o_circ_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "O_CIRC_WINDOWS";
            bindings = <&o_circ_lower_windows>, <&o_circ_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dash_question: dash_question {
            compatible = "zmk,behavior-mod-morph";
            label = "DASH_QUESTION";
            bindings = <&kp NUMBER_6>, <&kp LS(M)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        a_circ_windows: a_circ_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "A_CIRC_WINDOWS";
            bindings = <&a_circ_windows_lower>, <&a_circ_windows_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        c_cedilla_windows: c_cedilla_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "C_CEDILLA_WINDOWS";
            bindings = <&c_cedila_lower_windows>, <&c_cedilla_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        a_grave_windows: a_grave_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "A_GRAVE_WINDOWS";
            bindings = <&a_grave_lower_windows>, <&a_grave_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_acute_windows: e_acute_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "E_ACUTE_WINDOWS";
            bindings = <&e_acute_lower_windows>, <&e_acute_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_grave_windows: e_grave_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "E_GRAVE_WINDOWS";
            bindings = <&e_grave_lower_windows>, <&e_grave_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_grave_windows: u_grave_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "U_GRAVE_WINDOWS";
            bindings = <&u_grave_lower_windows>, <&u_grave_upper_windows>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        accent_layer_linux: accent_layer_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "ACCENT_LAYER_LINUX";
            bindings = <&to 3>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        accent_layer_windows: accent_layer_windows {
            compatible = "zmk,behavior-mod-morph";
            label = "ACCENT_LAYER_WINDOWS";
            bindings = <&to 4>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ae_ligature_linux: ae_ligature_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "AE_LIGATURE_LINUX";
            bindings = <&ae_ligature_linux_lower>, <&ae_ligature_linux_upper>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RCTL)>;
        };

        u_grave_linux: u_grave_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "U_GRAVE_LINUX";
            bindings = <&u_grave_lower_linux>, <&u_grave_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_circ_linux: u_circ_linux {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CIRC_LINUX";
            bindings = <&u_circ_lower_linux>, <&u_circ_upper_linux>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        left_parenthesis_linux_nocase: left_parenthesis_linux_nocase {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_PARENTHESIS_LINUX_NOCASE";
            bindings = <&left_parenthesis_linux>, <&left_parenthesis_linux>;

