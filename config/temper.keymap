        e_grave_lower_linux: e_grave_lower_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_7 &to 1>;
            label = "E_GRAVE_LOWER_LINUX";
