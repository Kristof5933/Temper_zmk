    combos {
        compatible = "zmk,combos";

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <21 22>;
            layers = <1 0 2>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <22 23>;
            layers = <1>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
            layers = <1>;
        };

        screenshot {
            bindings = <&kp LC(PRINTSCREEN)>;
            key-positions = <9 8>;
            layers = <1 0 2>;
        };

        boot_l {
            bindings = <&bootloader>;
            key-positions = <0 4 32>;
            layers = <1>;
        };

        win_nav_left {
            bindings = <&kp LG(LEFT)>;
            key-positions = <16 17>;
            layers = <11>;
        };

        win_nav_right {
            bindings = <&kp LG(RIGHT)>;
            key-positions = <19 18>;
            layers = <11>;
        };

        win_nav_up {
            bindings = <&kp LG(UP_ARROW)>;
            key-positions = <7 8>;
            layers = <11>;
        };

        win_nav_down {
            bindings = <&kp LG(DOWN_ARROW)>;
            key-positions = <17 18>;
            layers = <11>;
        };

        win_nav_left_shift {
            bindings = <&kp LG(LS(LEFT))>;
            key-positions = <16 17 18>;
            layers = <11>;
        };

        win_nav_right_shift {
            bindings = <&kp LG(LS(RIGHT))>;
            key-positions = <19 18 17>;
            layers = <11>;
        };

        mouse_layer_switch {
            bindings = <&tog 12>;
            key-positions = <14 15>;
            timeout-ms = <175>;
        };

        linux_to_windows {
            bindings = <&to 2>;
            key-positions = <33 34>;
            layers = <1>;
        };

        windows_to_ergol {
            bindings = <&to 0>;
            key-positions = <33 34>;
            layers = <2>;
        };

        ergol_to_linux {
            bindings = <&to 1>;
            key-positions = <33 34>;
            layers = <0>;
        };

        windows_focus {
            bindings = <&mo 11>;
            key-positions = <31 32>;
            layers = <2 1 0>;
        };

        paste_with_mouse {
            bindings = <&shift_right_click>;
            key-positions = <5 6>;
        };

        backspace_combo {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;
            layers = <0 2 1>;
        };

        Tmux_layer {
            bindings = <&mo 13>;
            key-positions = <30 31>;
        };
    };

    macros {
        a_circ_linux_lower: a_circ_linux_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(Q) &to 1>;
            label = "A_CIRC_LINUX_LOWER";
        };

        a_circ_linux_upper: a_circ_linux_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(A) &to 1>;
