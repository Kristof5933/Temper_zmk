        };

        c_cedilla_linux_lower: c_cedilla_linux_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(R) &to 1>;
            label = "C_CEDILLA_LINUX_LOWER";
