            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(O) &to 2>;
            label = "O_CIRC_MAJ";
        };

        circ: circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N9)>;
            label = "CIRC";
        };

        back_tick: back_tick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N7) &kp SPACE>;
            label = "BACK_TICK";
        };

        oe_ligature_windows_lower: oe_ligature_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_N1 &kp KP_N5 &kp KP_N6 &kt LEFT_ALT &to 2>;
            label = "OE_LIGATURE_WINDOWS";
        };

        tilde_windows: tilde_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(NUMBER_2) &kp SPACE>;
            label = "TILDE_WINDOWS";
        };

        ae_ligature_windows_lower: ae_ligature_windows_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N0 &kt LEFT_ALT &to 2>;
            label = "AE_LIGATURE_WINDOWS_LOWER";
        };

        a_circ_windows_upper: a_circ_windows_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp LS(Q) &to 2>;
